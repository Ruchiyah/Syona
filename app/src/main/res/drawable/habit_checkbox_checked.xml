<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:startColor="@color/checkbox_checked_start"
                android:endColor="@color/checkbox_checked_end"
                android:angle="45" />
            <size
                android:width="28dp"
                android:height="28dp" />
            <stroke
                android:width="1dp"
                android:color="@color/checkbox_checked_border" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:drawable="@drawable/ic_check_mark" />
</layer-list>