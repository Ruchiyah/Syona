<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp"
        android:background="@drawable/bg_sheet_mood"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/moodSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_how_are_you_feeling"
                android:textColor="@color/color_mood_sheet_title_start"
                android:textSize="24sp"
                android:letterSpacing="0.01"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/moodSheetClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_sheet_close_button"
                android:contentDescription="@string/content_description_close_banner"
                android:padding="8dp"
                android:src="@drawable/ic_close_small"
                app:tint="@color/color_mood_sheet_close_icon" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/moodPickerRecycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="80dp"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_mood_option" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/moodNoteLayout"
            style="@style/Widget.Syona.MoodNoteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="@string/label_add_note_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/moodNoteEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top|start"
                android:textColor="@color/color_on_background"
                android:background="@android:color/transparent"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_sheet_save_button"
            android:padding="2dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveMoodButton"
                style="@style/Widget.Syona.MoodSaveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_save_entry"
                android:stateListAnimator="@null" />

        </FrameLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
