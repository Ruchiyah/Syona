<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_habits">

    <fragment
        android:id="@+id/navigation_habits"
        android:name="com.example.syona.ui.habits.HabitsFragment"
        android:label="Habits"
        tools:layout="@layout/fragment_habits" />

    <fragment
        android:id="@+id/navigation_mood"
        android:name="com.example.syona.ui.mood.MoodFragment"
        android:label="Mood Journal"
        tools:layout="@layout/fragment_mood" />

    <fragment
        android:id="@+id/navigation_hydration"
        android:name="com.example.syona.ui.hydration.HydrationFragment"
        android:label="Hydration"
        tools:layout="@layout/fragment_hydration" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.example.syona.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_settings"
            app:destination="@id/navigation_settings" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.syona.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
